{
  "name": "lorecraft",
  "license": "AGPL-3.0-only",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "description": "A Wikipedia-style lorebook and novel writer with local or frontier AI.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p lorecraft -p lorecraft-minilm",
    "i18n": "node scripts/i18n-extract.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "version:check": "node scripts/check-version.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:debug": "tauri build --debug --no-bundle",
    "app:release": "tauri build",
    "portable": "node scripts/portable.mjs",
    "e2e": "node --test --test-concurrency=1 --test-reporter=spec \"e2e/*.test.mjs\"",
    "trailer": "node e2e/trailer.mjs && node scripts/make-apng.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libertinus-serif": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/core": "^3.32.3",
    "@tiptap/extension-bubble-menu": "^3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-typography": "^3.32.3",
    "@tiptap/extensions": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "csstype": "^3.2.3",
    "d3-force": "^3.0.1",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-ru": "^3.0.0",
    "diff": "^9.0.0",
    "docx": "^9.15.2",
    "fast-equals": "^6.2.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.5.438",
    "prosemirror-state": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xmlbuilder": "^15.1.1",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "csv-parse": "^7.0.3",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
